# ============================================================================
# Calango Bot - Modelo de Variaveis de Ambiente
# ----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA versione o `.env` (ja esta no .gitignore). Segredos so via process.env.
# Este unico `.env` na raiz serve ao backend (backend/config/env.js) e ao
# frontend (o script `start` usa `env-cmd -f ../.env`).
# ============================================================================

# --- Banco de Dados (MongoDB central dedicado, porta 27018) ---
MONGO_URI=mongodb://usuario:senha@host:27018/calango-bot?authSource=admin

# --- Autenticacao ---
# Segredo legado do Calango-Bot (tokens locais - descontinuado apos CP4)
JWT_SECRET=troque_por_uma_chave_forte
# Chave COMPARTILHADA com o Squamata-Login para validar tokens SSO.
# Deve ser identica em Squamata-Login, Calango-Food e Calango-Bot.
JWT_SECRET_LOGIN=chave_compartilhada_squamata_login

# --- URLs e Portas ---
PORT=3001                         # porta interna do backend (container)
BACKEND_PORT=3001                 # porta interna do backend (container)
# URL base do frontend do Calango-Bot (usada em callbacks/emails legados)
FRONTEND_URL=http://localhost:3004
# URL do Squamata-Login Frontend (Identity Provider / SSO)
FRONTEND_LOGIN_URL=http://localhost:5174

# --- Frontend (Create React App - prefixo REACT_APP_) ---
# Porta HOST do backend (nao a interna). No navegador, localhost:3001 = Squamata-Login.
# Sem /api nem /api/v1: o cliente injeta /api/v1 via interceptor (services/apiVersion.js).
REACT_APP_API_URL=http://localhost:3003
REACT_APP_WS_URL=http://localhost:3003
# URL do Squamata-Login (Identity Provider / SSO) - usada nos redirects de auth
REACT_APP_LOGIN_URL=http://localhost:5174

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3004,https://bot.calangoapp.com.br

# --- APIs de IA ---
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=troque
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=troque
OPENAI_API_KEY=troque

# --- Integracao Squamata Upload (porta 3005) e Firebase ---
# Base SEM versao: o cliente monta /api/v1/upload/generate-upload-url.
REACT_APP_FIREBASE_BUCKET=seu-bucket.appspot.com
REACT_APP_SQUAMATA_UPLOAD_API_URL=http://localhost:3005
REACT_APP_SQUAMATA_UPLOAD_API_KEY=troque

# --- WhatsApp (Twilio - provider alternativo) ---
TWILIO_ACCOUNT_SID=troque
TWILIO_AUTH_TOKEN=troque
TWILIO_WHATSAPP_NUMBER=whatsapp:+000000000

# --- Google OAuth (LEGADO - sera removido no CP3/CP4) ---
GOOGLE_CLIENT_ID=troque
GOOGLE_CLIENT_SECRET=troque

# --- E-mail (SMTP) ---
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASS=troque

# --- Integracao Meta (Facebook) para o CRM ---
META_VERIFY_TOKEN=troque

# --- Observabilidade ---
# Defina como 'true' APENAS em ambiente local com proxy corporativo
# IGNORE_SSL_ERRORS=false
